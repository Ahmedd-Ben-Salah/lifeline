# ───────── Lifeline environment ─────────
# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.

# Required in production: any long random string (signs login sessions and agent messages).
#   generate one:  openssl rand -base64 32
AUTH_SECRET=

# Your Claude API key (console.anthropic.com → API keys). Leave empty to run with scripted agents.
ANTHROPIC_API_KEY=
# Model used by the agents (default claude-opus-5-5). Cheaper alternative: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# llm = Claude writes agent messages and answers questions (scripted fallback on error/timeout)
# scripted = never call the API (offline demo)
AGENTS_MODE=llm

# Demo time scaling: real Earth–Mars light delay (~6.4 min in the scenario) × scale → seconds on stage
DEMO_DELAY_SCALE=0.1
# Agent reply timeout (20 min policy) × scale → seconds on stage
DEMO_TIMEOUT_SCALE=0.02

# Optional but recommended on Vercel: shared state across serverless instances.
# Vercel → Storage / Marketplace → "Upstash for Redis" (free) sets KV_REST_API_URL + KV_REST_API_TOKEN automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (or the Upstash names)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
